# kerbrutez live integration tests — configuration template.
#
# Copy this file to `.env` (which is git-ignored) to enable the live tests in
# src/test_integration.zig. They run a real Kerberos exchange against the KDC
# you point them at, so they need an actual lab.
#
#   cp .env.example .env   # then edit, then:  zig build test
#
# Without a `.env`, those tests SKIP themselves (error.SkipZigTest) and the rest
# of the suite passes as normal — so unconfigured/CI runs are never affected.
# NEVER commit real credentials; `.env` stays local.

# Required for the enumeration test:
KERBRUTEZ_TEST_DOMAIN=corp.example.com
KERBRUTEZ_TEST_DC=10.0.0.10            # IP or host[:port] (Kerberos defaults to :88)
KERBRUTEZ_TEST_VALID_USER=alice        # a username that EXISTS in the realm

# Optional — enables the credential (login) test as well:
KERBRUTEZ_TEST_USER=alice
KERBRUTEZ_TEST_PASS=                   # alice's real password (kept only in .env)
